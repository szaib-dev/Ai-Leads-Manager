# Public project URL and publishable key from Supabase > Project Settings > API.
# These identify the project; authorization is enforced by Supabase Auth and RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Legacy anon JWT keys are also accepted here. NEVER use a service_role JWT or sb_secret_ key.
# No service-role key or database password belongs in application configuration.

# Optional CSV auto-mapping only. Manual imports work without any AI configuration.
# Server-only: never prefix this key with NEXT_PUBLIC_.
DEEPSEEK_API_KEY=
# Applied privately to the database with npm run ai:configure after migrations.
AI_MONTHLY_BUDGET_USD=1.75
AI_INPUT_USD_PER_MILLION=0.30
AI_OUTPUT_USD_PER_MILLION=1.20
AI_PRICING_VERIFIED_DATE=2026-11-04

# Enable only after migration 202611130032 and private-channel QA pass.
NEXT_PUBLIC_PRIVATE_PATCHES=false
