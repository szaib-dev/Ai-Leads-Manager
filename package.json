{
  "name": "lead-workspace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:auth-ui": "node tests/fixtures/auth-ui.mjs",
    "test:routes": "node tests/route-protection.mjs",
    "ai:configure": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/configure-ai.mjs",
    "test:ai": "node --conditions=react-server --import tsx --test tests/ai-provider.test.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.67.0",
    "next": "^16.4.4",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
